pipeline {
    agent any
    stages {
        stage('Hello') {
            steps {
                echo "Build number "+ currentBuild.number
            }
            post {
                success {
                    script {
                        currentBuild.result = "FAILURE"
                    }
                }
            }
        }
        post {
            always {
                echo currentBuild.currentResult
            }
        }
    }
}